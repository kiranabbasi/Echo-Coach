# ── EchoCoach Backend — Required Environment Variables ───────────────────────
# Copy this file to .env and fill in all required values before starting server.

# =============================================================================
# CORE AI CONFIGURATION
# =============================================================================

# ── Google AI Studio (Gemma Primary LLM) ─────────────────────────────────────
# https://aistudio.google.com/app/apikey
# Primary conversational + grammar + diagnostic backend
GEMINI_API_KEY=
GEMMA_MODEL=gemma-3-27b-it

# ── Groq (STT + Fallback LLM) ────────────────────────────────────────────────
# https://console.groq.com/keys
# Used for:
#   - Whisper Large-v3 speech-to-text
#   - Llama fallback if Gemma fails
# Free tier available
GROQ_API_KEY=

# =============================================================================
# DATABASE + AUTH
# =============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
# Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# SESSION STATE / MEMORY
# =============================================================================

# ── Upstash Redis ─────────────────────────────────────────────────────────────
# https://console.upstash.com/
# Used for:
#   - Live session state
#   - Conversation history
#   - Temporary memory + interruption state
REDIS_URL=

# =============================================================================
# TEXT-TO-SPEECH CONFIGURATION
# =============================================================================

# ── TTS Mode ──────────────────────────────────────────────────────────────────
# edge     → Microsoft Edge Neural TTS (FREE, recommended for development)
# cartesia → Cartesia Sonic streaming (recommended for production)
# silent   → Disable audio entirely (backend logic testing only)
DEV_TTS=edge

# ── Cartesia (Only if DEV_TTS=cartesia) ──────────────────────────────────────
# https://play.cartesia.ai/
CARTESIA_API_KEY=
CARTESIA_VOICE_ID_AMERICAN=
CARTESIA_VOICE_ID_BRITISH=

# =============================================================================
# BACKEND SERVER CONFIG
# =============================================================================

# ── FastAPI Environment ───────────────────────────────────────────────────────
# development / production
ENVIRONMENT=development

# Backend port
PORT=8000

# Optional frontend origin for CORS
FRONTEND_URL=http://localhost:8081

# =============================================================================
# OPTIONAL DEBUGGING
# =============================================================================

# true / false
DEBUG=true

# Log LLM fallback errors
LOG_LLM_ERRORS=true