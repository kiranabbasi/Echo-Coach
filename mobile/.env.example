# ── EchoCoach Mobile — Expo environment variables ───────────────────────────
# Copy to .env and fill in values. EXPO_PUBLIC_ prefix makes them available
# in the JS bundle at build time.

# ── Supabase (mobile anon key — safe to expose in client) ────────────────────
# Dashboard → project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Backend URL ───────────────────────────────────────────────────────────────
# Local dev: use your machine's LAN IP (not localhost — won't reach from device)
# e.g. http://192.168.1.100:8000 or your Railway/Render deployment URL
EXPO_PUBLIC_BACKEND_HTTP_URL=http://localhost:8000
EXPO_PUBLIC_BACKEND_WS_URL=ws://localhost:8000

# ── LiveKit (optional — only if using LiveKit for WebRTC instead of WS) ───────
EXPO_PUBLIC_LIVEKIT_URL=
